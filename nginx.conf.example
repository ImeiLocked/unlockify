# Ejemplo de configuracion Nginx (reverse proxy -> Node en el puerto 3000)
# Copia a: /etc/nginx/sites-available/unlockify   y crea el symlink a sites-enabled.
# Luego corre certbot para el SSL gratis.

server {
    listen 80;
    server_name TU-DOMINIO.com www.TU-DOMINIO.com;

    # (Certbot agregara aqui el bloque 443/SSL automaticamente)

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    client_max_body_size 5m;
}
