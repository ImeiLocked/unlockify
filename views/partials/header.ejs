<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'en' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> · <%= brand %></title>
  <meta name="description" content="<%= brand %> — <%= t('site.metaDesc') %>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="stylesheet" href="/static/css/styles.css?v=20261125hero">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 56 56'><defs><linearGradient id='g' x1='0' y1='0' x2='1' y2='1'><stop offset='0' stop-color='%2322d3ee'/><stop offset='1' stop-color='%2316a34a'/></linearGradient></defs><rect width='56' height='56' rx='14' fill='url(%23g)'/><path d='M19 25 V16 Q19 7 28 7 Q35.5 7 37 13.5' stroke='%23ffffff' stroke-width='4.2' fill='none' stroke-linecap='round'/><rect x='12' y='24' width='32' height='24' rx='8' fill='%23ffffff'/><path d='M31 26 L22 37 H28 L24 47 L37 35 H30 Z' fill='%23f6a821'/></svg>">
</head>
<body>
<header class="nav">
  <div class="nav-inner container">
    <a class="brand" href="/">
      <span class="brand-mark"><svg width="42" height="42" viewBox="0 0 56 56" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"><path d="M19 25 V16 Q19 7 28 7 Q35.5 7 37 13.5" stroke="#fff" stroke-width="4.2" fill="none" stroke-linecap="round"/><rect x="12" y="24" width="32" height="24" rx="8" fill="#fff"/><path d="M31 26 L22 37 H28 L24 47 L37 35 H30 Z" fill="#f6a821"/></svg></span><% var bn = String(brand || 'Unlockify'); var hasIfy = /ify$/i.test(bn); %><span class="brand-name"><%= hasIfy ? bn.slice(0, -3) : bn %><% if (hasIfy) { %><span class="brand-accent"><%= bn.slice(-3) %></span><% } %></span>
    </a>
    <button class="nav-toggle" type="button" aria-label="Menu" aria-expanded="false"
            onclick="var m=this.parentNode.querySelector('.nav-links');this.setAttribute('aria-expanded', m.classList.toggle('open'))">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
    <nav class="nav-links">
      <a href="/" class="<%= currentPath === '/' ? 'active' : '' %>"><%= t('site.services') %></a>
      <a href="/how-it-works" class="<%= currentPath === '/how-it-works' ? 'active' : '' %>"><%= t('site.howItWorks') %></a>
      <% if (user) { %>
        <% if (user.is_admin) { %>
          <a href="/admin" class="<%= currentPath.indexOf('/admin') === 0 ? 'active' : '' %>">⚙ <%= lang === 'en' ? 'Admin' : 'Admin' %></a>
        <% } else { %>
          <a href="/dashboard" class="<%= currentPath === '/dashboard' ? 'active' : '' %>"><%= t('site.dashboard') %></a>
          <% if (canBuy) { %>
            <% if (typeof userBalance === 'number') { %><a href="/dashboard" class="bal-chip" title="<%= t('site.dashboard') %>">💰 $<%= userBalance.toFixed(2) %></a><% } %>
            <a href="/topup" class="btn btn-primary btn-sm"><%= t('site.addFunds') %></a>
          <% } %>
        <% } %>
        <a href="/account" class="<%= currentPath === '/account' ? 'active' : '' %>"><%= t('site.myAccount') %></a>
        <form action="/logout" method="post" class="inline"><button class="btn btn-ghost btn-sm"><%= t('site.logout') %></button></form>
      <% } else { %>
        <a href="/login"><%= t('site.login') %></a>
        <a href="/register" class="btn btn-primary btn-sm"><%= t('site.signup') %></a>
      <% } %>
      <% if (!layoutAdmin) { %>
        <span class="lang-switch" title="<%= t('nav.language') %>">
          <a href="/lang/en" class="<%= lang==='en' ? 'active' : '' %>">EN</a><span class="sep">·</span><a href="/lang/es" class="<%= lang==='es' ? 'active' : '' %>">ES</a>
        </span>
      <% } %>
    </nav>
  </div>
</header>
<main class="container page">
