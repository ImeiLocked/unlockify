<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'en' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> · <%= brand %></title>
  <meta name="description" content="<%= brand %> — <%= t('site.metaDesc') %>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="stylesheet" href="/static/css/styles.css">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 56 56'><rect width='56' height='56' rx='14' fill='%2316a34a'/><path d='M20 26V18Q20 10 28 10Q35 10 36.5 15.5' stroke='%23ffffff' stroke-width='4.2' fill='none' stroke-linecap='round'/><rect x='13' y='25' width='30' height='22' rx='7' fill='%23ffffff'/><path d='M30 29L22.5 38H27.5L25.5 45L34 34H29Z' fill='%232563ff'/></svg>">
</head>
<body>
<header class="nav">
  <div class="nav-inner container">
    <a class="brand" href="/">
      <span class="brand-mark"><svg width="31" height="31" viewBox="0 0 56 56" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"><defs><linearGradient id="ulg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#2dd4bf"/><stop offset="1" stop-color="#16a34a"/></linearGradient></defs><path d="M19 25 V16 Q19 7 28 7 Q35.5 7 37 13.5" stroke="url(#ulg)" stroke-width="4.2" fill="none" stroke-linecap="round"/><rect x="12" y="24" width="32" height="24" rx="8" fill="url(#ulg)"/><path d="M30.5 28 L22 38.5 H28 L25.5 46 L35.5 34 H29.5 Z" fill="#2563ff"/></svg></span><% var bn = String(brand || 'Unlockify'); var hasIfy = /ify$/i.test(bn); %><span class="brand-name"><%= hasIfy ? bn.slice(0, -3) : bn %><% if (hasIfy) { %><span class="brand-accent"><%= bn.slice(-3) %></span><% } %></span>
    </a>
    <nav class="nav-links">
      <a href="/" class="<%= currentPath === '/' ? 'active' : '' %>"><%= t('site.services') %></a>
      <a href="/how-it-works" class="<%= currentPath === '/how-it-works' ? 'active' : '' %>"><%= t('site.howItWorks') %></a>
      <% if (user) { %>
        <% if (user.is_admin) { %>
          <a href="/admin"><%= t('site.dashboard') %></a>
        <% } else { %>
          <% if (canBuy) { %>
            <% if (typeof userBalance === 'number') { %><a href="/account" class="bal-chip">💰 $<%= userBalance.toFixed(2) %></a><% } %>
            <a href="/topup" class="btn btn-primary btn-sm"><%= t('site.addFunds') %></a>
          <% } %>
        <% } %>
        <a href="/account" class="<%= currentPath === '/account' ? 'active' : '' %>"><%= t('site.myAccount') %></a>
        <form action="/logout" method="post" class="inline"><button class="btn btn-ghost btn-sm"><%= t('site.logout') %></button></form>
      <% } else { %>
        <a href="/login"><%= t('site.login') %></a>
        <a href="/register" class="btn btn-primary btn-sm"><%= t('site.signup') %></a>
      <% } %>
      <% if (!layoutAdmin) { %>
        <span class="lang-switch" title="<%= t('nav.language') %>">
          <a href="/lang/en" class="<%= lang==='en' ? 'active' : '' %>">EN</a><span class="sep">·</span><a href="/lang/es" class="<%= lang==='es' ? 'active' : '' %>">ES</a>
        </span>
      <% } %>
    </nav>
  </div>
</header>
<main class="container page">
