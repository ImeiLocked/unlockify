<div class="admin-nav">
  <a href="/admin" class="<%= currentPath === '/admin' ? 'active' : '' %>"><%= t('nav.overview') %></a>
  <a href="/admin/orders" class="<%= currentPath.indexOf('/admin/orders') === 0 ? 'active' : '' %>"><%= t('nav.orders') %></a>
  <a href="/admin/services" class="<%= currentPath === '/admin/services' ? 'active' : '' %>"><%= t('nav.services') %></a>
  <a href="/admin/providers" class="<%= currentPath.indexOf('/admin/providers') === 0 ? 'active' : '' %>"><%= adminLang === 'en' ? '🔌 Providers' : '🔌 Proveedores' %></a>
  <a href="/admin/held" class="nav-has-badge <%= currentPath.indexOf('/admin/held') === 0 ? 'active' : '' %>"><%= adminLang === 'en' ? '⏳ Pending' : '⏳ Pendientes' %><span id="held-badge" class="nav-badge<%= (typeof heldCount !== 'undefined' && heldCount > 0) ? '' : ' hidden' %>"><%= (typeof heldCount !== 'undefined' && heldCount > 0) ? (heldCount > 99 ? '99+' : heldCount) : '' %></span></a>
  <a href="/admin/unmatched" class="nav-has-badge <%= currentPath.indexOf('/admin/unmatched') === 0 ? 'active' : '' %>"><%= adminLang === 'en' ? '🔍 Payments' : '🔍 Pagos' %><span id="unmatched-badge" class="nav-badge<%= (typeof unmatchedCount !== 'undefined' && unmatchedCount > 0) ? '' : ' hidden' %>"><%= (typeof unmatchedCount !== 'undefined' && unmatchedCount > 0) ? (unmatchedCount > 99 ? '99+' : unmatchedCount) : '' %></span></a>
  <a href="/admin/users" class="<%= currentPath.indexOf('/admin/users') === 0 ? 'active' : '' %>"><%= t('nav.users') %></a>
  <a href="/admin/topups" class="<%= currentPath === '/admin/topups' ? 'active' : '' %>"><%= t('nav.topups') %></a>
  <a href="/admin/support" class="nav-has-badge <%= currentPath.indexOf('/admin/support') === 0 ? 'active' : '' %>"><%= t('nav.support') %><span id="support-badge" class="nav-badge<%= (typeof supportPending !== 'undefined' && supportPending > 0) ? '' : ' hidden' %>"><%= (typeof supportPending !== 'undefined' && supportPending > 0) ? (supportPending > 99 ? '99+' : supportPending) : '' %></span></a>
  <a href="/admin/announcements" class="<%= currentPath.indexOf('/admin/announcements') === 0 ? 'active' : '' %>"><%= adminLang === 'en' ? 'News' : 'Novedades' %></a>
  <a href="/admin/account" class="<%= currentPath.indexOf('/admin/account') === 0 ? 'active' : '' %>"><%= t('nav.account') %></a>
  <a href="/"><%= t('nav.viewStore') %></a>
  <span class="admin-lang" title="<%= t('nav.language') %>" style="margin-left:auto;display:inline-flex;gap:4px;align-items:center">
    <span style="opacity:.6">🌐</span>
    <a href="/admin/lang/es" class="<%= adminLang==='es' ? 'active' : '' %>">ES</a>
    <span style="opacity:.4">·</span>
    <a href="/admin/lang/en" class="<%= adminLang==='en' ? 'active' : '' %>">EN</a>
  </span>
</div>
<script>
(function () {
  function paint(el, n) {
    if (!el) return;
    if (n > 0) { el.textContent = n > 99 ? '99+' : n; el.classList.remove('hidden'); }
    else { el.textContent = ''; el.classList.add('hidden'); }
  }
  function poll(url, key, el) {
    if (!el) return;
    fetch(url, { headers: { 'X-Requested-With': 'fetch' } })
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (d) { if (d) paint(el, d[key] || 0); })
      .catch(function () {});
  }
  var sb = document.getElementById('support-badge');
  var hb = document.getElementById('held-badge');
  var ub = document.getElementById('unmatched-badge');
  function refresh() {
    poll('/admin/support/pending-count', 'pending', sb);
    poll('/admin/held/count', 'held', hb);
    poll('/admin/unmatched/count', 'unmatched', ub);
  }
  setInterval(refresh, 30000);
})();
</script>
