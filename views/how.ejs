<%- include('partials/header') %>
<h1 class="page-title"><%= t('site.howItWorks') %></h1>
<div class="grid" style="grid-template-columns:repeat(auto-fill,minmax(240px,1fr))">
  <div class="card"><div class="price" style="font-size:30px">1</div><div class="svc-title"><%= t('how.step1t') %></div><p class="muted small"><%= t('how.step1d') %></p></div>
  <div class="card"><div class="price" style="font-size:30px">2</div><div class="svc-title"><%= t('how.step2t') %></div><p class="muted small"><%= t('how.step2d') %></p></div>
  <div class="card"><div class="price" style="font-size:30px">3</div><div class="svc-title"><%= t('how.step3t') %></div><p class="muted small"><%= t('how.step3d') %></p></div>
  <div class="card"><div class="price" style="font-size:30px">4</div><div class="svc-title"><%= t('how.step4t') %></div><p class="muted small"><%= t('how.step4d') %></p></div>
</div>
<div class="panel" style="margin-top:24px">
  <h3 style="margin-top:0"><%= t('how.faq') %></h3>
  <div class="kv" style="display:block;border-bottom:1px solid var(--border);padding:12px 0">
    <strong><%= t('how.q1') %></strong>
    <p class="muted small" style="margin:6px 0 0"><%= t('how.a1') %></p>
  </div>
  <div class="kv" style="display:block;border-bottom:1px solid var(--border);padding:12px 0">
    <strong><%= t('how.q2') %></strong>
    <p class="muted small" style="margin:6px 0 0"><%= t('how.a2') %></p>
  </div>
  <div class="kv" style="display:block;padding:12px 0">
    <strong><%= t('how.q3') %></strong>
    <p class="muted small" style="margin:6px 0 0"><%= t('how.a3') %></p>
  </div>
</div>
<%- include('partials/footer') %>
