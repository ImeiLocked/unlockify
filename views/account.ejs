<%- include('partials/header') %>
<div class="balance-hero" style="margin-bottom:20px">
  <div>
    <div class="lbl">Hi<%= user.name ? ', ' + user.name : '' %> 👋 — your balance</div>
    <div class="amt">$<%= balance.toFixed(2) %></div>
  </div>
  <div style="display:flex;gap:10px">
    <a class="btn btn-primary" href="/topup">Add funds</a>
    <a class="btn btn-ghost" href="/">Shop</a>
  </div>
</div>

<div class="section-head"><h2>My orders</h2></div>
<div class="panel" style="overflow-x:auto;margin-bottom:24px">
  <table class="table">
    <thead><tr><th>Order</th><th>Service</th><th>Price</th><th>Status</th><th>Time</th><th></th></tr></thead>
    <tbody>
      <% if (orders.length === 0) { %><tr><td colspan="6" class="muted">You don't have any orders yet. <a href="/" style="color:var(--primary)">Browse services →</a></td></tr><% } %>
      <% orders.forEach(function(o){ %>
        <tr>
          <td><strong><%= o.code %></strong><br><span class="muted small"><%= o.created_at %></span></td>
          <td style="max-width:260px"><%= o.service_title %><br><span class="muted small"><%= o.identifier_type==='serial'?'# ':'IMEI ' %><%= o.identifier %></span></td>
          <td>$<%= o.price.toFixed(2) %></td>
          <td><span class="pill <%= o.status %>"><%= ({queued:'Processing',processing:'Processing',completed:'Completed',rejected:'Rejected',cancelled:'Cancelled'})[o.status] %></span></td>
          <td class="small"><%= o.total_seconds!=null ? (o.total_seconds<60? o.total_seconds+'s' : Math.floor(o.total_seconds/60)+'m') : '—' %></td>
          <td><a class="btn btn-ghost btn-sm" href="/order/<%= o.code %>">View</a></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<div class="section-head"><h2>Top-ups</h2></div>
<div class="panel" style="overflow-x:auto;margin-bottom:24px">
  <table class="table">
    <thead><tr><th>Top-up</th><th>Amount</th><th>Network</th><th>Status</th><th></th></tr></thead>
    <tbody>
      <% if (topups.length === 0) { %><tr><td colspan="5" class="muted">No top-ups yet.</td></tr><% } %>
      <% topups.forEach(function(t){ %>
        <tr>
          <td><strong><%= t.code %></strong><br><span class="muted small"><%= t.created_at %></span></td>
          <td><%= t.expected_amount %> USDT</td>
          <td><%= t.chain.toUpperCase() %></td>
          <td><span class="pill <%= t.status === 'confirmed' ? 'completed' : (t.status==='expired'?'rejected':'queued') %>"><%= ({pending:'Pending',confirmed:'Confirmed',expired:'Expired'})[t.status] %></span></td>
          <td><% if (t.status==='pending') { %><a class="btn btn-ghost btn-sm" href="/topup/<%= t.code %>">Pay</a><% } %></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<div class="section-head"><h2>Balance history</h2></div>
<div class="panel" style="overflow-x:auto">
  <table class="table">
    <thead><tr><th>Date</th><th>Type</th><th>Amount</th><th>Balance</th><th>Ref</th></tr></thead>
    <tbody>
      <% if (ledger.length === 0) { %><tr><td colspan="5" class="muted">No activity.</td></tr><% } %>
      <% ledger.forEach(function(m){ %>
        <tr>
          <td class="small"><%= m.created_at %></td>
          <td><%= ({topup:'Top-up',order:'Purchase',refund:'Refund',admin_credit:'Adjustment +',admin_debit:'Adjustment −'})[m.type] || m.type %></td>
          <td style="color:<%= m.amount>=0 ? 'var(--primary)' : 'var(--danger)' %>"><%= m.amount>=0?'+':'' %><%= m.amount.toFixed(2) %></td>
          <td>$<%= m.balance_after.toFixed(2) %></td>
          <td class="small muted"><%= m.ref || '' %></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>
<%- include('partials/footer') %>
