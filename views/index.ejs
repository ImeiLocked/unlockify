<%- include('partials/header') %>

<section class="hero">
  <h1><%- t('home.h1') %></h1>
  <p><%= t('home.sub') %></p>
  <div class="hero-badges">
    <span class="chip"><%- t('home.badge1') %></span>
    <span class="chip"><%- t('home.badge2') %></span>
    <span class="chip"><%- t('home.badge3') %></span>
    <span class="chip"><%- t('home.badge4') %></span>
  </div>
</section>

<% if (categories.length === 0) { %>
  <div class="panel" style="margin-top:30px">
    <p class="muted"><%= t('home.noServices') %></p>
  </div>
<% } %>

<% categories.forEach(function(cat){ %>
  <section class="section" id="<%= cat.slug %>">
    <div class="section-head">
      <div>
        <h2><%= cat.name %></h2>
        <% if (cat.description) { %><p class="muted"><%= cat.description %></p><% } %>
      </div>
    </div>
    <div class="grid">
      <% cat.services.forEach(function(s){ %>
        <div class="card">
          <div class="svc-title"><%= s.title %></div>
          <div class="svc-meta">
            <% if (s.delivery_time) { %><span class="badge badge-time">⏱ <%= s.delivery_time %></span><% } %>
            <span class="badge badge-id"><%= s.identifier_type === 'serial' ? t('badge.serial') : 'IMEI' %></span>
          </div>
          <div style="display:flex;align-items:center;justify-content:space-between;gap:10px">
            <div class="price">$<%= s.price.toFixed(2) %> <small>USDT</small></div>
          </div>
          <a class="btn btn-primary" href="/service/<%= s.id %>"><%= t('home.orderNow') %></a>
        </div>
      <% }); %>
    </div>
  </section>
<% }); %>

<%- include('partials/footer') %>
