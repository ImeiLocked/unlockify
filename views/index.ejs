<%- include('partials/header') %>

<section class="hero">
  <h1><span class="grad">Fast and secure</span> unlocks<br>for your iPhone and iPad</h1>
  <p>FMI OFF, MDM bypass and network unlock with a 100% success rate. Order in minutes and pay securely with USDT.</p>
  <div class="hero-badges">
    <span class="chip">⚡ <strong>Fast delivery</strong></span>
    <span class="chip">🔒 Pay with <strong>USDT (TRC20 / ERC20)</strong></span>
    <span class="chip">✅ <strong>100%</strong> success</span>
    <span class="chip">🤖 <strong>Automatic</strong> process</span>
  </div>
</section>

<% if (categories.length === 0) { %>
  <div class="panel" style="margin-top:30px">
    <p class="muted">No services loaded yet. If you're the admin, sync the catalog from the dashboard.</p>
  </div>
<% } %>

<% categories.forEach(function(cat){ %>
  <section class="section" id="<%= cat.slug %>">
    <div class="section-head">
      <div>
        <h2><%= cat.name %></h2>
        <% if (cat.description) { %><p class="muted"><%= cat.description %></p><% } %>
      </div>
    </div>
    <div class="grid">
      <% cat.services.forEach(function(s){ %>
        <div class="card">
          <div class="svc-title"><%= s.title %></div>
          <div class="svc-meta">
            <% if (s.delivery_time) { %><span class="badge badge-time">⏱ <%= s.delivery_time %></span><% } %>
            <span class="badge badge-id"><%= s.identifier_type === 'serial' ? '# Serial' : 'IMEI' %></span>
          </div>
          <div style="display:flex;align-items:center;justify-content:space-between;gap:10px">
            <div class="price">$<%= s.price.toFixed(2) %> <small>USDT</small></div>
          </div>
          <a class="btn btn-primary" href="/service/<%= s.id %>">Order now</a>
        </div>
      <% }); %>
    </div>
  </section>
<% }); %>

<%- include('partials/footer') %>
