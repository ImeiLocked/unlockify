<%- include('partials/header') %>
<%- include('partials/announcements-modal') %>

<section class="hero">
  <h1><%- t('home.h1') %></h1>
  <p><%= t('home.sub') %></p>
  <div class="hero-badges">
    <span class="chip"><%- t('home.badge1') %></span>
    <span class="chip"><%- t('home.badge2') %></span>
    <span class="chip"><%- t('home.badge3') %></span>
    <span class="chip"><%- t('home.badge4') %></span>
  </div>
</section>

<% var EN = (typeof lang !== 'undefined' && lang === 'en');
   var feats = [
     { ic:'🗄️', c:'f-blue',   t: EN?'Verified Sources':'Fuentes verificadas', d: EN?'IMEI and GSX data pulled from verified global databases for accurate, reliable results.':'Datos IMEI y GSX de bases globales verificadas, para resultados precisos y confiables.' },
     { ic:'⚡', c:'f-green',  t: EN?'Instant Response':'Respuesta inmediata', d: EN?'Receive IMEI results and unlock confirmations fast, around the clock.':'Recibe resultados y confirmaciones de desbloqueo rápido, las 24 horas.' },
     { ic:'📈', c:'f-violet', t: EN?'99.9% Uptime':'99.9% disponible', d: EN?'Distributed infrastructure keeps the platform fast and stable for every order.':'Infraestructura distribuida que mantiene la plataforma rápida y estable.' },
     { ic:'🛡️', c:'f-amber',  t: EN?'Secure Platform':'Plataforma segura', d: EN?'SSL encryption and secure authentication keep your account and data protected.':'Cifrado SSL y autenticación segura protegen tu cuenta y tus datos.' },
     { ic:'💸', c:'f-rose',   t: EN?'Refund Guarantee':'Garantía de reembolso', d: EN?'If an eligible service fails on our side, your balance is credited back.':'Si un servicio elegible falla de nuestro lado, se te reembolsa el saldo.' },
     { ic:'🌍', c:'f-slate',  t: EN?'Worldwide Coverage':'Cobertura mundial', d: EN?'Services for Apple, Xiaomi, Samsung and more — available worldwide.':'Servicios para Apple, Xiaomi, Samsung y más — disponibles en todo el mundo.' }
   ]; %>
<section class="features">
  <% feats.forEach(function(f){ %>
    <div class="feature">
      <div class="feature-ic <%= f.c %>"><%= f.ic %></div>
      <h3><%= f.t %></h3>
      <p class="muted"><%= f.d %></p>
    </div>
  <% }); %>
</section>

<% if (pending) { %>
  <div class="alert alert-warn" style="margin-top:20px"><%= t('gate.pendingBanner') %></div>
<% } %>

<% if (categories.length === 0) { %>
  <div class="panel" style="margin-top:30px">
    <p class="muted"><%= t('home.noServices') %></p>
  </div>
<% } %>

<% if (categories.length > 0) { %>
<div class="shop-toolbar" id="shopToolbar">
  <div class="shop-toolbar-inner container">
    <span class="shop-ic">🔎</span>
    <select id="groupFilter" class="input">
      <option value=""><%= EN ? 'All groups' : 'Todos los grupos' %></option>
      <% categories.forEach(function(cat){ %><option value="<%= cat.slug %>"><%= cat.name %></option><% }); %>
    </select>
    <input id="svcSearch" class="input" placeholder="<%= EN ? 'Search service…' : 'Buscar servicio…' %>" autocomplete="off">
    <span class="muted small" id="shopCount"></span>
  </div>
</div>
<% } %>

<% categories.forEach(function(cat){ %>
  <section class="section" id="<%= cat.slug %>">
    <div class="section-head">
      <div>
        <h2><%= cat.name %></h2>
        <% if (cat.description) { %><p class="muted"><%= cat.description %></p><% } %>
      </div>
    </div>
    <div class="grid">
      <% cat.services.forEach(function(s){ %>
        <div class="card" data-title="<%= s.title %>">
          <div class="svc-title"><%= s.title %></div>
          <div class="svc-meta">
            <% if (s.delivery_time) { %><span class="badge badge-time">⏱ <%= s.delivery_time %></span><% } %>
            <span class="badge badge-id"><%= s.identifier_type === 'serial' ? t('badge.serial') : 'IMEI' %></span>
          </div>
          <% if (canBuy) { %>
            <div class="card-foot">
              <div class="price">$<%= s.price.toFixed(2) %> <small>USDT</small></div>
              <a class="btn btn-primary btn-sm card-order" href="/service/<%= s.id %>"><%= t('home.orderNow') %> →</a>
            </div>
          <% } else { %>
            <div class="card-foot card-foot-gate">
              <span class="muted small"><%= user ? t('gate.cardPending') : t('gate.cardGuest') %></span>
              <% if (!user) { %><a class="btn btn-ghost btn-sm" href="/login"><%= t('site.login') %></a><% } %>
            </div>
          <% } %>
        </div>
      <% }); %>
    </div>
  </section>
<% }); %>

<div id="noResults" class="panel" style="display:none;margin-top:16px">
  <p class="muted" style="margin:0"><%= EN ? 'No services match your search.' : 'Ningún servicio coincide con tu búsqueda.' %></p>
</div>

<style>
.shop-toolbar{position:sticky;top:0;z-index:20;background:var(--bg,#f6f8fb);padding:10px 0;margin:6px 0 10px;border-bottom:1px solid var(--border,#e5e7eb)}
.shop-toolbar-inner{display:flex;gap:10px;align-items:center}
.shop-ic{opacity:.5}
#groupFilter{max-width:280px}
#svcSearch{flex:1;min-width:160px}
#shopCount{white-space:nowrap}
@media(max-width:620px){ .shop-toolbar-inner{flex-wrap:wrap} #groupFilter{max-width:none;flex:1} }
</style>
<script>
(function(){
  var sel = document.getElementById('groupFilter');
  var q = document.getElementById('svcSearch');
  if (!sel || !q) return;
  var sections = Array.prototype.slice.call(document.querySelectorAll('section.section'));
  var count = document.getElementById('shopCount');
  var none = document.getElementById('noResults');
  function apply(){
    var g = sel.value;
    var term = (q.value||'').trim().toLowerCase();
    var shown = 0;
    sections.forEach(function(sec){
      var groupOk = !g || g === sec.id;
      var vis = 0;
      sec.querySelectorAll('.card').forEach(function(c){
        var t = (c.getAttribute('data-title')||'').toLowerCase();
        var ok = groupOk && (!term || t.indexOf(term) !== -1);
        c.style.display = ok ? '' : 'none';
        if (ok) vis++;
      });
      sec.style.display = vis ? '' : 'none';
      shown += vis;
    });
    if (none) none.style.display = shown ? 'none' : '';
    if (count) count.textContent = shown + (/* label */ '<%= EN ? " services" : " servicios" %>');
  }
  sel.addEventListener('change', apply);
  q.addEventListener('input', apply);
  apply();
})();
</script>

<%- include('partials/footer') %>
