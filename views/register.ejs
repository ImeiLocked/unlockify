<%- include('partials/header') %>
<div class="form-wrap">
  <div class="panel">
    <h1><%= t('reg.title') %></h1>
    <p class="muted" style="margin-top:0"><%= t('reg.sub') %></p>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <form action="/register" method="post">
      <div class="field">
        <label><%= t('field.name') %></label>
        <input class="input" type="text" name="name" value="<%= form.name || '' %>" placeholder="<%= t('common.optional') %>">
      </div>
      <div class="field">
        <label><%= t('field.email') %></label>
        <input class="input" type="email" name="email" value="<%= form.email || '' %>" required>
      </div>
      <div class="field">
        <label><%= t('field.password') %></label>
        <input class="input" type="password" name="password" minlength="6" required>
        <div class="hint"><%= t('reg.passwordHint') %></div>
      </div>
      <button class="btn btn-primary btn-lg" type="submit"><%= t('reg.title') %></button>
    </form>
    <p class="form-foot"><%= t('reg.haveAccount') %> <a href="/login"><%= t('site.login') %></a></p>
  </div>
</div>
<%- include('partials/footer') %>
