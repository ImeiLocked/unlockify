<%- include('partials/header') %>
<a class="back" href="/account"><%= t('ordr.back') %></a>

<div class="order-grid">
  <div class="panel" data-poll="/order/<%= order.code %>/status.json" data-status="<%= order.status %>" data-active="queued,processing">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
      <h1 style="margin:0;font-size:22px"><%= t('order.title') %> <%= order.code %></h1>
      <span class="pill <%= order.status %>"><%= t('ostatus.'+order.status) %></span>
    </div>
    <p class="muted" style="margin-top:0"><%= order.service_title %></p>

    <% if (order.status === 'completed') { %>
      <div class="statusbar status-completed" style="margin-bottom:14px"><%= t('ordr.completed') %></div>
      <label class="muted small"><%= t('ordr.result') %></label>
      <div class="result-box"><%= order.result_text || t('ordr.resultDefault') %></div>
    <% } else if (order.status === 'rejected') { %>
      <div class="statusbar status-rejected"><%- t('ordr.rejected', { amt: order.price.toFixed(2) }) %></div>
      <a class="btn btn-primary" style="margin-top:14px" href="/service/<%= order.service_id %>"><%= t('ordr.tryAgain') %></a>
    <% } else { %>
      <div class="statusbar status-processing"><span class="spinner"></span> <%= t('ordr.processing') %></div>
      <p class="hint" style="margin-top:14px"><%= t('ordr.processingNote') %></p>
    <% } %>
  </div>

  <aside class="panel">
    <h3 style="margin-top:0"><%= t('ordr.summary') %></h3>
    <div class="kv"><span><%= t('col.order') %></span><strong><%= order.code %></strong></div>
    <div class="kv"><span><%= order.identifier_type === 'serial' ? t('label.serial') : t('label.imei') %></span><strong><%= order.identifier %></strong></div>
    <div class="kv"><span><%= t('col.price') %></span><strong>$<%= order.price.toFixed(2) %> USDT</strong></div>
    <div class="kv"><span><%= t('col.date') %></span><span class="small"><%= order.created_at %></span></div>
    <% if (order.total_seconds != null && order.status === 'completed') { %>
      <div class="kv"><span><%= t('ordr.resolvedIn') %></span><strong><%= order.total_seconds < 60 ? order.total_seconds + 's' : Math.floor(order.total_seconds/60) + 'm ' + (order.total_seconds%60) + 's' %></strong></div>
    <% } %>
  </aside>
</div>

<div class="toast" id="toast"><%= t('btn.copy') %> ✅</div>
<script src="/static/js/pay.js"></script>
<%- include('partials/footer') %>
