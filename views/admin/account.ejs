<%- include('../partials/header') %>
<%- include('../partials/adminnav') %>
<h1 class="page-title"><%= t('acctAdmin.title') %></h1>

<div class="form-wrap" style="margin-left:0">
  <div class="panel">
    <h3 style="margin:0 0 4px"><%= t('acctAdmin.changePassword') %></h3>
    <p class="muted small" style="margin-top:0"><%= t('acctAdmin.hint') %></p>

    <% if (ok) { %><div class="alert alert-ok"><%= t('acctAdmin.ok') %></div><% } %>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <form action="/admin/account/password" method="post">
      <div class="field">
        <label><%= t('acctAdmin.current') %></label>
        <input class="input" type="password" name="current" required autocomplete="current-password">
      </div>
      <div class="field">
        <label><%= t('acctAdmin.new') %></label>
        <input class="input" type="password" name="password" minlength="6" required autocomplete="new-password">
      </div>
      <div class="field">
        <label><%= t('acctAdmin.confirm') %></label>
        <input class="input" type="password" name="confirm" minlength="6" required autocomplete="new-password">
      </div>
      <button class="btn btn-primary btn-lg" type="submit"><%= t('acctAdmin.save') %></button>
    </form>
  </div>
</div>
<%- include('../partials/footer') %>
