<%- include('../partials/header') %>
<%- include('../partials/adminnav') %>
<h1 class="page-title">Overview</h1>

<div class="stats">
  <div class="stat"><div class="n"><%= stats.total || 0 %></div><div class="l">Orders</div></div>
  <div class="stat"><div class="n" style="color:var(--warn)"><%= stats.queued || 0 %></div><div class="l">Queued (manual)</div></div>
  <div class="stat"><div class="n" style="color:var(--accent)"><%= stats.processing || 0 %></div><div class="l">Processing</div></div>
  <div class="stat good"><div class="n"><%= stats.completed || 0 %></div><div class="l">Completed</div></div>
  <div class="stat"><div class="n" style="color:var(--danger)"><%= stats.rejected || 0 %></div><div class="l">Rejected</div></div>
  <div class="stat"><div class="n">$<%= (stats.revenue || 0).toFixed(2) %></div><div class="l">Completed sales</div></div>
  <div class="stat"><div class="n"><%= usersCount %></div><div class="l">Customers</div></div>
  <div class="stat"><div class="n" style="color:var(--warn)"><%= pendingTopups %></div><div class="l">Pending top-ups</div></div>
</div>

<div class="panel" style="margin-bottom:20px">
  <h3 style="margin:0 0 10px">Providers</h3>
  <% if (providers.length === 0) { %>
    <p class="muted">No providers configured. Add them in <code>.env</code> (PROVIDER_1_*, PROVIDER_2_* blocks).</p>
  <% } else { %>
    <div style="display:flex;gap:10px;flex-wrap:wrap">
      <% providers.forEach(function(p){ %>
        <span class="chip"><%= p.name %> · <%= (p.enabled && p.apiUrl && p.apiKey) ? '🟢 active' : '⚪ no API' %></span>
      <% }); %>
    </div>
  <% } %>
</div>

<div class="panel" style="overflow-x:auto">
  <h3 style="margin:0 0 10px">Latest orders</h3>
  <table class="table">
    <thead><tr><th>Order</th><th>Service</th><th>Customer</th><th>Price</th><th>Provider</th><th>Status</th><th></th></tr></thead>
    <tbody>
      <% if (recent.length === 0) { %><tr><td colspan="7" class="muted">No orders yet.</td></tr><% } %>
      <% recent.forEach(function(o){ %>
        <tr>
          <td><strong><%= o.code %></strong></td>
          <td style="max-width:220px"><%= o.service_title %></td>
          <td class="small"><%= o.user_email %></td>
          <td>$<%= o.price.toFixed(2) %></td>
          <td class="small"><%= o.provider_key || '—' %></td>
          <td><span class="pill <%= o.status %>"><%= o.status %></span></td>
          <td><a class="btn btn-ghost btn-sm" href="/admin/orders/<%= o.code %>">Open</a></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>
<%- include('../partials/footer') %>
