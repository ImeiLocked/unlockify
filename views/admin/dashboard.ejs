<%- include('../partials/header') %>
<%- include('../partials/adminnav') %>
<h1 class="page-title">Resumen</h1>

<div class="stats">
  <div class="stat"><div class="n"><%= stats.total || 0 %></div><div class="l">Pedidos</div></div>
  <div class="stat"><div class="n" style="color:var(--warn)"><%= stats.queued || 0 %></div><div class="l">En cola (manual)</div></div>
  <div class="stat"><div class="n" style="color:var(--accent)"><%= stats.processing || 0 %></div><div class="l">Procesando</div></div>
  <div class="stat good"><div class="n"><%= stats.completed || 0 %></div><div class="l">Completados</div></div>
  <div class="stat"><div class="n" style="color:var(--danger)"><%= stats.rejected || 0 %></div><div class="l">Rechazados</div></div>
  <div class="stat"><div class="n">$<%= (stats.revenue || 0).toFixed(2) %></div><div class="l">Ventas completadas</div></div>
  <div class="stat"><div class="n"><%= usersCount %></div><div class="l">Clientes</div></div>
  <div class="stat"><div class="n" style="color:var(--warn)"><%= pendingTopups %></div><div class="l">Recargas pendientes</div></div>
</div>

<div class="panel" style="margin-bottom:20px">
  <h3 style="margin:0 0 10px">Proveedores</h3>
  <% if (providers.length === 0) { %>
    <p class="muted">No hay proveedores configurados. Agrégalos en el <code>.env</code> (bloques PROVIDER_1_*, PROVIDER_2_*).</p>
  <% } else { %>
    <div style="display:flex;gap:10px;flex-wrap:wrap">
      <% providers.forEach(function(p){ %>
        <span class="chip"><%= p.name %> · <%= (p.enabled && p.apiUrl && p.apiKey) ? '🟢 activo' : '⚪ sin API' %></span>
      <% }); %>
    </div>
  <% } %>
</div>

<div class="panel" style="overflow-x:auto">
  <h3 style="margin:0 0 10px">Últimos pedidos</h3>
  <table class="table">
    <thead><tr><th>Pedido</th><th>Servicio</th><th>Cliente</th><th>Precio</th><th>Proveedor</th><th>Estado</th><th></th></tr></thead>
    <tbody>
      <% if (recent.length === 0) { %><tr><td colspan="7" class="muted">Aún no hay pedidos.</td></tr><% } %>
      <% recent.forEach(function(o){ %>
        <tr>
          <td><strong><%= o.code %></strong></td>
          <td style="max-width:220px"><%= o.service_title %></td>
          <td class="small"><%= o.user_email %></td>
          <td>$<%= o.price.toFixed(2) %></td>
          <td class="small"><%= o.provider_key || '—' %></td>
          <td><span class="pill <%= o.status %>"><%= o.status %></span></td>
          <td><a class="btn btn-ghost btn-sm" href="/admin/orders/<%= o.code %>">Abrir</a></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>
<%- include('../partials/footer') %>
