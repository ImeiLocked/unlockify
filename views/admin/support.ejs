<%- include('../partials/header') %>
<%- include('../partials/adminnav') %>
<h1 class="page-title"><%= t('support.title') %></h1>

<% if (!imapOn) { %>
  <div class="alert" style="background:#fff7ed;border:1px solid #fed7aa;color:#9a3412">
    <%= t('support.imapOff') %>
  </div>
<% } %>

<div class="panel" style="padding:0;overflow:hidden">
  <% if (!threads.length) { %>
    <div style="padding:30px;text-align:center" class="muted"><%= t('support.empty') %></div>
  <% } else { %>
    <table class="table" style="width:100%;border-collapse:collapse">
      <thead>
        <tr style="text-align:left;border-bottom:1px solid #eef1f4;font-size:13px;color:#8a94a6">
          <th style="padding:12px 16px"><%= t('support.client') %></th>
          <th style="padding:12px 16px"><%= t('support.subject') %></th>
          <th style="padding:12px 16px"><%= t('support.lastAt') %></th>
          <th style="padding:12px 16px"></th>
        </tr>
      </thead>
      <tbody>
        <% threads.forEach(function(th){ var pend = th.pending || 0; %>
          <tr style="border-bottom:1px solid #f1f4f7;<%= pend ? 'background:#fff1f2' : '' %>">
            <td style="padding:12px 16px">
              <div style="display:flex;align-items:center;gap:9px">
                <% if (pend) { %>
                  <span title="<%= lang === 'en' ? 'messages awaiting your reply' : 'mensajes sin responder' %>"
                        style="flex:0 0 auto;min-width:22px;height:22px;box-sizing:border-box;padding:0 6px;background:#ef4444;color:#fff;border-radius:999px;font-size:12px;font-weight:800;line-height:22px;text-align:center;box-shadow:0 2px 6px rgba(239,68,68,.4)"><%= pend %></span>
                <% } %>
                <a href="/admin/support/<%= th.id %>" style="font-weight:700;color:#0e1420;text-decoration:none"><%= th.client_name || th.client_email %></a>
              </div>
              <% if (th.client_name) { %><div class="muted small" style="margin-left:<%= pend ? '31px' : '0' %>"><%= th.client_email %></div><% } %>
            </td>
            <td style="padding:12px 16px"><%= th.subject || '—' %></td>
            <td style="padding:12px 16px" class="muted small"><%= th.last_at %></td>
            <td style="padding:12px 16px;text-align:right;white-space:nowrap">
              <% if (pend) { %>
                <span style="color:#b91c1c;font-size:12px;font-weight:700;margin-right:8px"><%= pend %> <%= lang === 'en' ? (pend === 1 ? 'to reply' : 'to reply') : 'sin responder' %></span>
                <a href="/admin/support/<%= th.id %>" class="btn btn-sm" style="background:#ef4444;color:#fff;border-color:#ef4444"><%= lang === 'en' ? 'Reply' : 'Responder' %></a>
              <% } else { %>
                <span style="color:#16a34a;font-size:12px;font-weight:700;margin-right:8px">✓ <%= lang === 'en' ? 'answered' : 'respondido' %></span>
                <a href="/admin/support/<%= th.id %>" class="btn btn-sm"><%= t('support.open') %></a>
              <% } %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>
</div>
<p class="muted small" style="margin-top:12px"><%= t('support.retentionNote') %></p>
<%- include('../partials/footer') %>
