<%- include('../partials/header') %>
<%- include('../partials/adminnav') %>
<h1 class="page-title"><%= t('support.title') %></h1>

<% if (!imapOn) { %>
  <div class="alert" style="background:#fff7ed;border:1px solid #fed7aa;color:#9a3412">
    <%= t('support.imapOff') %>
  </div>
<% } %>

<div class="panel" style="padding:0;overflow:hidden">
  <% if (!threads.length) { %>
    <div style="padding:30px;text-align:center" class="muted"><%= t('support.empty') %></div>
  <% } else { %>
    <table class="table" style="width:100%;border-collapse:collapse">
      <thead>
        <tr style="text-align:left;border-bottom:1px solid #eef1f4;font-size:13px;color:#8a94a6">
          <th style="padding:12px 16px"><%= t('support.client') %></th>
          <th style="padding:12px 16px"><%= t('support.subject') %></th>
          <th style="padding:12px 16px"><%= t('support.lastAt') %></th>
          <th style="padding:12px 16px"></th>
        </tr>
      </thead>
      <tbody>
        <% threads.forEach(function(th){ %>
          <tr style="border-bottom:1px solid #f1f4f7;<%= th.unread ? 'background:#f0fdf4' : '' %>">
            <td style="padding:12px 16px">
              <a href="/admin/support/<%= th.id %>" style="font-weight:700;color:#0e1420;text-decoration:none"><%= th.client_name || th.client_email %></a>
              <% if (th.client_name) { %><div class="muted small"><%= th.client_email %></div><% } %>
            </td>
            <td style="padding:12px 16px"><%= th.subject || '—' %></td>
            <td style="padding:12px 16px" class="muted small"><%= th.last_at %></td>
            <td style="padding:12px 16px;text-align:right">
              <% if (th.unread) { %><span style="background:#16a34a;color:#fff;border-radius:999px;padding:2px 9px;font-size:12px;font-weight:700"><%= th.unread %> <%= t('support.newBadge') %></span><% } %>
              <a href="/admin/support/<%= th.id %>" class="btn btn-sm" style="margin-left:8px"><%= t('support.open') %></a>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>
</div>
<p class="muted small" style="margin-top:12px"><%= t('support.retentionNote') %></p>
<%- include('../partials/footer') %>
