<%- include('../partials/header') %>
<%- include('../partials/adminnav') %>
<h1 class="page-title">Órdenes</h1>

<div class="admin-nav">
  <% ['all','queued','processing','completed','rejected'].forEach(function(s){ %>
    <a href="/admin/orders?status=<%= s %>" class="<%= status === s ? 'active' : '' %>"><%= ({all:'Todas',queued:'En cola',processing:'Procesando',completed:'Completadas',rejected:'Rechazadas'})[s] %></a>
  <% }); %>
</div>

<div class="panel" style="overflow-x:auto">
  <table class="table">
    <thead><tr><th>Pedido</th><th>Servicio</th><th>IMEI/Serie</th><th>Cliente</th><th>Precio</th><th>Proveedor</th><th>Estado</th><th>Tiempo</th><th></th></tr></thead>
    <tbody>
      <% if (orders.length === 0) { %><tr><td colspan="9" class="muted">Sin órdenes en este filtro.</td></tr><% } %>
      <% orders.forEach(function(o){ %>
        <tr>
          <td><strong><%= o.code %></strong><br><span class="muted small"><%= o.created_at %></span></td>
          <td style="max-width:200px"><%= o.service_title %></td>
          <td class="small"><%= o.identifier %></td>
          <td class="small"><%= o.user_email %></td>
          <td>$<%= o.price.toFixed(2) %></td>
          <td class="small"><%= o.provider_key ? providerName(o.provider_key) : (o.auto ? 'auto' : 'manual') %></td>
          <td><span class="pill <%= o.status %>"><%= o.status %></span><% if (o.refunded) { %> <span class="pill refunded">reemb.</span><% } %></td>
          <td class="small"><%= o.total_seconds!=null ? (o.total_seconds<60?o.total_seconds+'s':Math.floor(o.total_seconds/60)+'m') : '—' %></td>
          <td><a class="btn btn-ghost btn-sm" href="/admin/orders/<%= o.code %>">Abrir</a></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>
<%- include('../partials/footer') %>
