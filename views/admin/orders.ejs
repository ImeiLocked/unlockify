<%- include('../partials/header') %>
<%- include('../partials/adminnav') %>
<h1 class="page-title"><%= t('orders.title') %></h1>

<div class="admin-nav">
  <% ['all','queued','processing','completed','rejected'].forEach(function(s){ %>
    <a href="/admin/orders?status=<%= s %>" class="<%= status === s ? 'active' : '' %>"><%= t('filter.'+s) %></a>
  <% }); %>
</div>

<div class="panel" style="overflow-x:auto">
  <table class="table">
    <thead><tr><th><%= t('col.order') %></th><th><%= t('col.service') %></th><th><%= t('col.imeiSerial') %></th><th><%= t('col.customer') %></th><th><%= t('col.price') %></th><th><%= t('col.provider') %></th><th><%= t('col.status') %></th><th><%= t('col.time') %></th><th></th></tr></thead>
    <tbody>
      <% if (orders.length === 0) { %><tr><td colspan="9" class="muted"><%= t('orders.noneFilter') %></td></tr><% } %>
      <% orders.forEach(function(o){ %>
        <tr>
          <td><strong><%= o.code %></strong><br><span class="muted small"><%= o.created_at %></span></td>
          <td style="max-width:200px"><%= o.service_title %></td>
          <td class="small"><%= o.identifier %></td>
          <td class="small"><%= o.user_email %></td>
          <td>$<%= o.price.toFixed(2) %></td>
          <td class="small"><%= o.provider_key ? providerName(o.provider_key) : (o.auto ? 'auto' : 'manual') %></td>
          <td><span class="pill <%= o.status %>"><%= o.status %></span><% if (o.refunded) { %> <span class="pill refunded"><%= t('tag.refund') %></span><% } %></td>
          <td class="small"><%= o.total_seconds!=null ? (o.total_seconds<60?o.total_seconds+'s':Math.floor(o.total_seconds/60)+'m') : '—' %></td>
          <td><a class="btn btn-ghost btn-sm" href="/admin/orders/<%= o.code %>"><%= t('btn.open') %></a></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>
<%- include('../partials/footer') %>
