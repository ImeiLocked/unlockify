<%- include('../partials/header') %>
<%- include('../partials/adminnav') %>
<h1 class="page-title">📢 <%= lang === 'en' ? 'Announcements' : 'Novedades' %></h1>

<div class="panel" style="margin-bottom:18px">
  <h3 style="margin:0 0 4px"><%= lang === 'en' ? 'Add announcement' : 'Agregar novedad' %></h3>
  <p class="muted small" style="margin-top:0"><%= lang === 'en' ? 'New services, price changes or notices. Shown to customers in a pop-up.' : 'Nuevos servicios, cambios de precio o avisos. Se muestran a los clientes en un recuadro.' %></p>
  <form action="/admin/announcements" method="post">
    <div class="field">
      <textarea class="input" name="body" rows="2" required placeholder="<%= lang === 'en' ? 'e.g. Xiaomi Mi Account Remove (Argentina) — now 19 USD' : 'ej. Xiaomi Mi Account Remove (Argentina) — ahora 19 USD' %>" style="resize:vertical"></textarea>
    </div>
    <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap">
      <select name="kind" class="input" style="max-width:220px">
        <option value="news"><%= lang === 'en' ? 'Notice' : 'Aviso' %></option>
        <option value="new"><%= lang === 'en' ? 'New service' : 'Servicio nuevo' %></option>
        <option value="price"><%= lang === 'en' ? 'Price change' : 'Cambio de precio' %></option>
      </select>
      <button class="btn btn-primary" type="submit"><%= lang === 'en' ? 'Publish' : 'Publicar' %></button>
    </div>
  </form>
</div>

<div class="panel" style="padding:0;overflow:hidden">
  <% if (!items.length) { %>
    <div style="padding:26px;text-align:center" class="muted"><%= lang === 'en' ? 'No announcements yet.' : 'Aún no hay novedades.' %></div>
  <% } else { %>
    <table class="table" style="width:100%;border-collapse:collapse">
      <thead>
        <tr style="text-align:left;border-bottom:1px solid var(--border);font-size:13px;color:var(--muted)">
          <th style="padding:12px 16px"><%= lang === 'en' ? 'Date' : 'Fecha' %></th>
          <th style="padding:12px 16px"><%= lang === 'en' ? 'Announcement' : 'Novedad' %></th>
          <th style="padding:12px 16px"><%= lang === 'en' ? 'Type' : 'Tipo' %></th>
          <th style="padding:12px 16px;text-align:right"></th>
        </tr>
      </thead>
      <tbody>
        <% items.forEach(function(a){ %>
          <tr style="border-bottom:1px solid var(--border);<%= a.active ? '' : 'opacity:.5' %>">
            <td style="padding:12px 16px" class="muted small" ><%= (a.created_at || '').slice(0,10) %></td>
            <td style="padding:12px 16px"><%= a.body %></td>
            <td style="padding:12px 16px">
              <span class="news-tag news-<%= a.kind %>"><%= a.kind === 'price' ? (lang==='en'?'price':'precio') : (a.kind === 'new' ? (lang==='en'?'new':'nuevo') : (lang==='en'?'notice':'aviso')) %></span>
            </td>
            <td style="padding:12px 16px;text-align:right;white-space:nowrap">
              <form action="/admin/announcements/<%= a.id %>/toggle" method="post" style="display:inline">
                <button class="btn btn-sm btn-ghost" type="submit"><%= a.active ? (lang==='en'?'Hide':'Ocultar') : (lang==='en'?'Show':'Mostrar') %></button>
              </form>
              <form action="/admin/announcements/<%= a.id %>/delete" method="post" style="display:inline" onsubmit="return confirm('<%= lang==='en'?'Delete this announcement?':'¿Eliminar esta novedad?' %>')">
                <button class="btn btn-sm" type="submit" style="color:var(--danger);border-color:var(--danger)"><%= lang==='en'?'Delete':'Eliminar' %></button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>
</div>
<%- include('../partials/footer') %>
