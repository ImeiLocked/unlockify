<%- include('../partials/header') %>
<%- include('../partials/adminnav') %>

<div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px">
  <h1 class="page-title" style="margin:0">Servicios</h1>
  <div style="display:flex;gap:8px;flex-wrap:wrap">
    <% providers.forEach(function(p){ if (p.enabled && p.apiUrl && p.apiKey) { %>
      <form action="/admin/sync/<%= p.key %>" method="post"><button class="btn btn-primary btn-sm" type="submit">🔄 Sincronizar <%= p.name %></button></form>
    <% } }); %>
  </div>
</div>

<div class="alert alert-info" style="margin-top:10px">
  Markup global: <strong><%= markup.type === 'percent' ? '+'+markup.value+'%' : '+$'+markup.value %></strong> (edítalo en el <code>.env</code>).
  Los servicios importados llegan <strong>apagados</strong>: préndelos cuando quieras venderlos. El cliente nunca ve proveedores ni costos.
  <% if (synced) { %><br><span style="color:var(--primary)">✓ <%= synced %></span><% } %>
</div>

<% services.forEach(function(s){ var f='svc'+s.id; %>
  <div class="panel" id="s<%= s.id %>" style="margin-bottom:14px">
    <form id="<%= f %>" action="/admin/services/<%= s.id %>" method="post"></form>
    <div style="display:flex;gap:10px;align-items:flex-start;flex-wrap:wrap">
      <div style="flex:1;min-width:240px">
        <input class="input" form="<%= f %>" name="title" value="<%= s.title %>">
        <div class="muted small" style="margin-top:4px"><%= s.category_name %> · precio venta <strong style="color:var(--primary)">$<%= s.price.toFixed(2) %></strong> (costo efectivo $<%= s.cost.toFixed(2) %>)</div>
      </div>
      <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
        <label class="small" style="display:flex;gap:4px;align-items:center"><input type="checkbox" form="<%= f %>" name="active" <%= s.active?'checked':'' %>> Visible</label>
        <label class="small" style="display:flex;gap:4px;align-items:center"><input type="checkbox" form="<%= f %>" name="auto_fulfill" <%= s.auto_fulfill?'checked':'' %>> ⚡ Automático</label>
      </div>
    </div>

    <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:10px">
      <select class="input" form="<%= f %>" name="identifier_type" style="width:110px">
        <option value="imei" <%= s.identifier_type==='imei'?'selected':'' %>>IMEI</option>
        <option value="serial" <%= s.identifier_type==='serial'?'selected':'' %>>Serie</option>
      </select>
      <select class="input" form="<%= f %>" name="markup_type" style="width:110px">
        <option value="" <%= !s.markup_type?'selected':'' %>>markup global</option>
        <option value="percent" <%= s.markup_type==='percent'?'selected':'' %>>%</option>
        <option value="fixed" <%= s.markup_type==='fixed'?'selected':'' %>>$ fijo</option>
      </select>
      <input class="input" form="<%= f %>" name="markup_value" value="<%= s.markup_value!=null?s.markup_value:'' %>" placeholder="auto" style="width:80px">
      <select class="input" form="<%= f %>" name="primary_provider" style="width:170px">
        <option value="">Proveedor: más barato</option>
        <% s.sources.forEach(function(src){ %><option value="<%= src.provider_key %>" <%= s.primary_provider===src.provider_key?'selected':'' %>>Fijo: <%= providerName(src.provider_key) %></option><% }); %>
      </select>
      <button class="btn btn-primary btn-sm" type="submit" form="<%= f %>">Guardar</button>
    </div>

    <div style="margin-top:12px">
      <div class="muted small" style="margin-bottom:4px">Fuentes (proveedores que lo surten):</div>
      <% s.sources.forEach(function(src){ var sf='src'+src.id; %>
        <div class="src-row">
          <span class="tag-prov"><%= providerName(src.provider_key) %></span>
          <form id="<%= sf %>" action="/admin/sources/<%= src.id %>" method="post"></form>
          <input class="input" form="<%= sf %>" name="cost" value="<%= src.cost %>" title="costo" inputmode="decimal">
          <input class="input" form="<%= sf %>" name="provider_service_id" value="<%= src.provider_service_id||'' %>" placeholder="ID servicio">
          <label class="small" style="display:flex;gap:4px;align-items:center"><input type="checkbox" form="<%= sf %>" name="active" <%= src.active?'checked':'' %>> on</label>
          <button class="btn btn-ghost btn-sm" type="submit" form="<%= sf %>">✓</button>
        </div>
      <% }); %>
      <% if (providers.length > s.sources.length) { %>
        <form action="/admin/services/<%= s.id %>/sources" method="post" class="src-row" style="margin-top:4px">
          <select class="input" name="provider_key">
            <% providers.forEach(function(p){ if (!s.sources.find(function(x){return x.provider_key===p.key;})) { %><option value="<%= p.key %>"><%= p.name %></option><% } }); %>
          </select>
          <input class="input" name="cost" placeholder="costo" inputmode="decimal">
          <input class="input" name="provider_service_id" placeholder="ID servicio">
          <span></span>
          <button class="btn btn-ghost btn-sm" type="submit">+ fuente</button>
        </form>
      <% } %>
    </div>
  </div>
<% }); %>
<% if (services.length === 0) { %><div class="panel"><p class="muted">No hay servicios. Sincroniza desde un proveedor o espera a cargar el catálogo.</p></div><% } %>
<%- include('../partials/footer') %>
