<%- include('../partials/header') %>
<%- include('../partials/adminnav') %>
<h1 class="page-title"><%= t('topups.title') %></h1>
<div class="panel" style="overflow-x:auto">
  <table class="table">
    <thead><tr><th><%= t('col.topup') %></th><th><%= t('col.customer') %></th><th><%= t('col.amount') %></th><th><%= t('col.network') %></th><th><%= t('col.status') %></th><th><%= t('col.tx') %></th><th><%= t('col.date') %></th></tr></thead>
    <tbody>
      <% if (topups.length===0) { %><tr><td colspan="7" class="muted"><%= t('topups.none') %></td></tr><% } %>
      <% topups.forEach(function(t2){ %>
        <tr>
          <td><strong><%= t2.code %></strong></td>
          <td class="small"><%= t2.user_email %></td>
          <td><% if (t2.status==='confirmed' && t2.received_amount != null) { %><strong><%= t2.received_amount %></strong> USDT<% if (Math.abs(t2.received_amount - t2.expected_amount) >= 0.01) { %> <span class="muted small">(<%= (typeof lang!=='undefined'&&lang==='en')?'asked':'pidió' %> <%= t2.expected_amount %>)</span><% } %><% } else { %><%= t2.expected_amount %> USDT<% } %></td>
          <td><%= t2.chain.toUpperCase() %></td>
          <td><span class="pill <%= t2.status==='confirmed'?'completed':(t2.status==='expired'?'rejected':'queued') %>"><%= t2.status %></span></td>
          <td class="small" style="max-width:160px;word-break:break-all"><%= t2.tx_hash || '—' %></td>
          <td class="small"><%= t2.created_at %></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>
<%- include('../partials/footer') %>
