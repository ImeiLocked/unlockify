<%- include('../partials/header') %>
<%- include('../partials/adminnav') %>
<a class="back" href="/admin/users"><%= t('user.allUsers') %></a>

<% if (newPassword) { %>
  <div class="alert alert-ok"><%= t('user.newPassword1') %> <strong><%= u.email %></strong>: <code style="font-size:16px"><%= newPassword %></code> <%= t('user.newPassword2') %></div>
<% } %>

<div class="order-grid">
  <div class="panel">
    <h1 style="margin:0;font-size:22px"><%= u.email %></h1>
    <p class="muted" style="margin-top:4px"><%= u.name || t('user.noName') %> · <%= t('user.joined') %> <%= u.created_at %></p>
    <div class="kv"><span><%= t('col.balance') %></span><strong style="color:var(--primary);font-size:20px">$<%= u.balance.toFixed(2) %></strong></div>
    <div class="kv"><span><%= t('user.status') %></span><% if (u.is_admin) { %><span><%= t('role.administrator') %></span><% } else { %><span class="pill <%= u.active?'completed':'rejected' %>"><%= u.active?t('status.active'):t('status.disabled') %></span><% } %></div>

    <div class="stats" style="margin:16px 0">
      <div class="stat"><div class="n">$<%= (stats.recharged||0).toFixed(2) %></div><div class="l"><%= t('user.lifetimeRecharged') %></div></div>
      <div class="stat"><div class="n"><%= stats.servicesCount||0 %></div><div class="l"><%= t('user.servicesPurchased') %></div></div>
      <div class="stat"><div class="n">$<%= (stats.totalSpent||0).toFixed(2) %></div><div class="l"><%= t('user.totalSpent') %></div></div>
      <% if ((stats.gifts||0) > 0) { %><div class="stat"><div class="n">$<%= stats.gifts.toFixed(2) %></div><div class="l"><%= t('user.lifetimeGifts') %></div></div><% } %>
    </div>

    <h3 style="margin:20px 0 8px"><%= t('user.orders') %></h3>
    <div style="overflow-x:auto"><table class="table">
      <thead><tr><th><%= t('col.order') %></th><th><%= t('col.service') %></th><th>$</th><th><%= t('col.status') %></th></tr></thead>
      <tbody>
        <% if (orders.length===0) { %><tr><td colspan="4" class="muted"><%= t('user.noOrders') %></td></tr><% } %>
        <% orders.forEach(function(o){ %><tr><td><a href="/admin/orders/<%= o.code %>"><%= o.code %></a></td><td style="max-width:220px"><%= o.service_title %></td><td><%= o.price.toFixed(2) %></td><td><span class="pill <%= o.status %>"><%= o.status %></span></td></tr><% }); %>
      </tbody>
    </table></div>

    <h3 style="margin:20px 0 8px"><%= t('user.balanceHistory') %></h3>
    <div style="overflow-x:auto"><table class="table">
      <thead><tr><th><%= t('col.date') %></th><th><%= t('col.type') %></th><th><%= t('col.amount') %></th><th><%= t('col.balance') %></th><th><%= t('col.ref') %></th></tr></thead>
      <tbody>
        <% if (ledger.length===0) { %><tr><td colspan="5" class="muted"><%= t('user.noActivity') %></td></tr><% } %>
        <% ledger.forEach(function(m){ %><tr><td class="small"><%= m.created_at %></td><td><%= t('ltype.'+m.type) %></td><td style="color:<%= m.amount>=0?'var(--primary)':'var(--danger)' %>"><%= m.amount>=0?'+':'' %><%= m.amount.toFixed(2) %></td><td>$<%= m.balance_after.toFixed(2) %></td><td class="small muted"><%= m.ref||'' %></td></tr><% }); %>
      </tbody>
    </table></div>
  </div>

  <aside class="panel">
    <h3 style="margin-top:0"><%= t('user.actions') %></h3>
    <% if (!u.is_admin) { %>
      <form action="/admin/users/<%= u.id %>/active" method="post" style="margin-bottom:14px">
        <button class="btn <%= u.active?'btn-danger':'btn-primary' %> btn-block" type="submit"><%= u.active ? t('user.disableBan') : t('user.activate') %></button>
      </form>
    <% } %>

    <form action="/admin/users/<%= u.id %>/balance" method="post" style="margin-bottom:14px">
      <label class="small muted"><%= t('user.adjustBalance') %></label>
      <select class="input" name="reason" style="margin-bottom:6px">
        <option value="payment"><%= t('user.reasonPayment') %></option>
        <option value="gift"><%= t('user.reasonGift') %></option>
        <option value="correction"><%= t('user.reasonCorrection') %></option>
      </select>
      <div style="display:flex;gap:6px"><input class="input" name="amount" placeholder="<%= t('user.adjustPlaceholder') %>" required><button class="btn btn-ghost" type="submit"><%= t('btn.apply') %></button></div>
      <input class="input" name="note" placeholder="<%= t('user.notePlaceholder') %>" style="margin-top:6px">
    </form>

    <form action="/admin/users/<%= u.id %>/password" method="post" onsubmit="return confirm('<%= t('user.confirmPassword') %>');">
      <label class="small muted"><%= t('user.resetPassword') %></label>
      <div style="display:flex;gap:6px"><input class="input" name="password" placeholder="<%= t('user.newBlankGenerate') %>"><button class="btn btn-ghost" type="submit"><%= t('btn.change') %></button></div>
      <p class="hint"><%= t('user.resetHint') %></p>
    </form>

    <% if (!u.is_admin) { %>
      <div style="height:1px;background:var(--border);margin:16px 0"></div>
      <label class="small muted" style="color:var(--danger)"><%= t('user.dangerZone') %></label>
      <form action="/admin/users/<%= u.id %>/delete" method="post" onsubmit="return confirm('<%= t('user.confirmDelete') %>');">
        <button class="btn btn-danger btn-block" type="submit" style="margin-top:6px"><%= t('user.deleteUser') %></button>
      </form>
      <p class="hint"><%= t('user.deleteHint') %></p>
    <% } %>
  </aside>
</div>
<%- include('../partials/footer') %>
