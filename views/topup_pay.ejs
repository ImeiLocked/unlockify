<%- include('partials/header') %>
<a class="back" href="/account">← My account</a>
<% var netLabel = topup.chain === 'trc20' ? 'USDT · TRON network (TRC20)' : 'USDT · Ethereum network (ERC20)'; %>

<div class="order-grid">
  <div class="panel" data-poll="/topup/<%= topup.code %>/status.json" data-status="<%= topup.status %>" data-active="pending" data-expires="<%= topup.expires_at %>">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
      <h1 style="margin:0;font-size:22px">Top-up <%= topup.code %></h1>
      <span class="pill <%= topup.status === 'confirmed' ? 'completed' : (topup.status === 'expired' ? 'rejected' : 'queued') %>">
        <%= ({pending:'Awaiting payment',confirmed:'Confirmed',expired:'Expired'})[topup.status] %>
      </span>
    </div>

    <% if (topup.status === 'pending') { %>
      <div class="alert alert-info">Send <strong>exactly</strong> the amount below to the address shown, on the correct network. It's credited automatically in 1-3 minutes.</div>
      <div class="field">
        <label>Exact amount to send</label>
        <div style="display:flex;align-items:center;gap:10px">
          <div class="pay-amount"><%= topup.expected_amount %></div><span class="muted">USDT</span>
          <button class="btn btn-ghost btn-sm copy-btn" data-copy="<%= topup.expected_amount %>">Copy</button>
        </div>
        <div class="hint">⚠️ Send the exact amount (including cents). That's how we identify your top-up automatically.</div>
      </div>
      <div class="field">
        <label>Network</label><div><span class="badge badge-ok" style="font-size:13px"><%= netLabel %></span></div>
        <div class="hint">Only <strong>USDT</strong> on this network. Another network or coin = loss of funds.</div>
      </div>
      <div class="field">
        <label>Address</label>
        <div class="addr-box"><code><%= topup.pay_address %></code><button class="btn btn-ghost btn-sm copy-btn" data-copy="<%= topup.pay_address %>">Copy</button></div>
      </div>
      <% if (qr) { %><div class="center" style="margin-top:12px"><div class="qr"><img src="<%= qr %>" alt="QR" width="200" height="200"></div><div class="hint">Scan to pay</div></div><% } %>
      <div class="statusbar status-pending" style="margin-top:18px"><span class="spinner"></span> Waiting for your payment… <span id="countdown"></span></div>
    <% } else if (topup.status === 'confirmed') { %>
      <div class="statusbar status-completed">✅ Top-up credited. Current balance: $<%= balance.toFixed(2) %> USDT</div>
      <a class="btn btn-primary" style="margin-top:14px" href="/">Go shopping</a>
    <% } else { %>
      <div class="statusbar status-expired">⌛ This top-up expired without receiving payment.</div>
      <a class="btn btn-primary" style="margin-top:14px" href="/topup">Create a new top-up</a>
    <% } %>
  </div>

  <aside class="panel">
    <h3 style="margin-top:0">Summary</h3>
    <div class="kv"><span>Top-up</span><strong><%= topup.code %></strong></div>
    <div class="kv"><span>Amount</span><strong><%= topup.expected_amount %> USDT</strong></div>
    <div class="kv"><span>Network</span><span><%= topup.chain.toUpperCase() %></span></div>
    <div class="kv"><span>Current balance</span><strong>$<%= balance.toFixed(2) %></strong></div>
  </aside>
</div>
<div class="toast" id="toast">Copied ✅</div>
<script src="/static/js/pay.js"></script>
<%- include('partials/footer') %>
