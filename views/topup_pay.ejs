<%- include('partials/header') %>
<a class="back" href="/account">← Mi cuenta</a>
<% var netLabel = topup.chain === 'trc20' ? 'USDT · red TRON (TRC20)' : 'USDT · red Ethereum (ERC20)'; %>

<div class="order-grid">
  <div class="panel" data-poll="/topup/<%= topup.code %>/status.json" data-status="<%= topup.status %>" data-active="pending" data-expires="<%= topup.expires_at %>">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
      <h1 style="margin:0;font-size:22px">Recarga <%= topup.code %></h1>
      <span class="pill <%= topup.status === 'confirmed' ? 'completed' : (topup.status === 'expired' ? 'rejected' : 'queued') %>">
        <%= ({pending:'Esperando pago',confirmed:'Confirmada',expired:'Expirada'})[topup.status] %>
      </span>
    </div>

    <% if (topup.status === 'pending') { %>
      <div class="alert alert-info">Envía <strong>exactamente</strong> el monto de abajo a la dirección indicada, por la red correcta. Se acredita solo en 1-3 minutos.</div>
      <div class="field">
        <label>Monto exacto a enviar</label>
        <div style="display:flex;align-items:center;gap:10px">
          <div class="pay-amount"><%= topup.expected_amount %></div><span class="muted">USDT</span>
          <button class="btn btn-ghost btn-sm copy-btn" data-copy="<%= topup.expected_amount %>">Copiar</button>
        </div>
        <div class="hint">⚠️ Envía el monto exacto (con los centavos). Así identificamos tu recarga automáticamente.</div>
      </div>
      <div class="field">
        <label>Red</label><div><span class="badge badge-ok" style="font-size:13px"><%= netLabel %></span></div>
        <div class="hint">Solo <strong>USDT</strong> por esta red. Otra red u otra moneda = pérdida de fondos.</div>
      </div>
      <div class="field">
        <label>Dirección</label>
        <div class="addr-box"><code><%= topup.pay_address %></code><button class="btn btn-ghost btn-sm copy-btn" data-copy="<%= topup.pay_address %>">Copiar</button></div>
      </div>
      <% if (qr) { %><div class="center" style="margin-top:12px"><div class="qr"><img src="<%= qr %>" alt="QR" width="200" height="200"></div><div class="hint">Escanea para pagar</div></div><% } %>
      <div class="statusbar status-pending" style="margin-top:18px"><span class="spinner"></span> Esperando tu pago… <span id="countdown"></span></div>
    <% } else if (topup.status === 'confirmed') { %>
      <div class="statusbar status-completed">✅ Recarga acreditada. Saldo actual: $<%= balance.toFixed(2) %> USDT</div>
      <a class="btn btn-primary" style="margin-top:14px" href="/">Ir a comprar</a>
    <% } else { %>
      <div class="statusbar status-expired">⌛ Esta recarga expiró sin recibir el pago.</div>
      <a class="btn btn-primary" style="margin-top:14px" href="/topup">Crear una nueva recarga</a>
    <% } %>
  </div>

  <aside class="panel">
    <h3 style="margin-top:0">Resumen</h3>
    <div class="kv"><span>Recarga</span><strong><%= topup.code %></strong></div>
    <div class="kv"><span>Monto</span><strong><%= topup.expected_amount %> USDT</strong></div>
    <div class="kv"><span>Red</span><span><%= topup.chain.toUpperCase() %></span></div>
    <div class="kv"><span>Saldo actual</span><strong>$<%= balance.toFixed(2) %></strong></div>
  </aside>
</div>
<div class="toast" id="toast">Copiado ✅</div>
<script src="/static/js/pay.js"></script>
<%- include('partials/footer') %>
