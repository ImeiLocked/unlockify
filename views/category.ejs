<%- include('partials/header') %>
<a class="back" href="/">← All services</a>
<div class="section-head">
  <div>
    <h1 class="page-title"><%= category.name %></h1>
    <% if (category.description) { %><p class="muted"><%= category.description %></p><% } %>
  </div>
</div>
<div class="grid">
  <% category.services.forEach(function(s){ %>
    <div class="card">
      <div class="svc-title"><%= s.title %></div>
      <div class="svc-meta">
        <% if (s.delivery_time) { %><span class="badge badge-time">⏱ <%= s.delivery_time %></span><% } %>
        <span class="badge badge-id"><%= s.identifier_type === 'serial' ? '# Serial' : 'IMEI' %></span>
      </div>
      <div class="price">$<%= s.price.toFixed(2) %> <small>USDT</small></div>
      <a class="btn btn-primary" href="/service/<%= s.id %>">Order now</a>
    </div>
  <% }); %>
  <% if (category.services.length === 0) { %>
    <p class="muted">We'll add services to this category soon.</p>
  <% } %>
</div>
<%- include('partials/footer') %>
