# ==========================================================================
#  CONFIGURACION — PANEL DE RESELLER (saldo prepago + multi-proveedor)
#  cp .env.example .env   y edita los valores
# ==========================================================================

# --- General -------------------------------------------------------------
BRAND_NAME=Unlockify
PUBLIC_URL=https://tudominio.com
PORT=3000
SESSION_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# --- Seguridad: 2FA por correo (OTP) + dispositivo de confianza -----------
# OTP_ENABLED=true pide un código al correo al iniciar sesión (necesita SMTP).
# Con OTP activo, la sesión se cierra tras SESSION_IDLE_MINUTES de inactividad.
# Si el usuario marca "dispositivo seguro", no le pide código en ese equipo
# por TRUSTED_DEVICE_DAYS días (solo 1 dispositivo seguro por usuario).
OTP_ENABLED=false
SESSION_IDLE_MINUTES=30
TRUSTED_DEVICE_DAYS=30
OTP_EXPIRY_MINUTES=5
OTP_RESEND_SECONDS=30

# --- Markup global (tu ganancia) -----------------------------------------
# percent => 35 = +35%.  fixed => 10 = +$10 por servicio
MARKUP_TYPE=percent
MARKUP_VALUE=35
# Redondeo: up_99 (.99), up_int (entero) o none
MARKUP_ROUNDING=up_99

# --- Wallets USDT (recibes las recargas; custodia propia) ----------------
# Tus direcciones de Trust Wallet (ya configuradas):
USDT_TRC20_ADDRESS=TDB8Pq6MckjSXKRU5LRSNypJMfFdJabcFc
USDT_ERC20_ADDRESS=0x18dDb06dCBCE094A694Dee8f1b8348AED1ed49cF
# Minimo de recarga (USDT)
MIN_TOPUP=10
# Minutos que dura una recarga antes de expirar
INVOICE_EXPIRY_MINUTES=40

# --- Vigilancia del blockchain (confirma recargas) -----------------------
TRONGRID_API_KEY=
ETHERSCAN_API_KEY=
PAYMENT_POLL_SECONDS=25
PROVIDER_POLL_SECONDS=30

# --- Telegram (te avisa SOLO a ti; los clientes nunca lo ven) ------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email (NOTIFICA A TUS CLIENTES: recarga, pedido recibido/listo) -----
# Sin esto, los clientes no reciben correos. Usa un SMTP real.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Tu correo (opcional): copia de avisos, además de Telegram
NOTIFY_EMAIL=

# --- Proveedores (hasta 6: PROVIDER_1_*, PROVIDER_2_*, ...) ---------------
# type=dhru (Dhru Fusion). enabled=true para activarlo.
# Proveedor 1 — imeilock.us (ya confirmado)
PROVIDER_1_KEY=imeilock
PROVIDER_1_NAME=IMEILock
PROVIDER_1_TYPE=dhru
PROVIDER_1_API_URL=https://www.imeilock.us/api/index.php
PROVIDER_1_USERNAME=matticell
PROVIDER_1_API_KEY=
PROVIDER_1_ENABLED=false

# Proveedor 2 — unlockking.us
PROVIDER_2_KEY=unlockking
PROVIDER_2_NAME=UnlockKing
PROVIDER_2_TYPE=dhru
PROVIDER_2_API_URL=https://www.unlockking.us/api/index.php
PROVIDER_2_USERNAME=Matt1406m
PROVIDER_2_API_KEY=
PROVIDER_2_ENABLED=false

# --- Admin inicial (se crea al primer arranque) --------------------------
ADMIN_EMAIL=admin@unlockify.com
ADMIN_PASSWORD=cambia-esta-clave-ya

# --- Envío por API de Zoho Mail (HTTPS, evita puertos SMTP bloqueados) ---
# Se obtienen con el Self Client en api-console.zoho.com (una sola vez).
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNT_ID=
ZOHO_FROM=support@unlockify.uk
# US=accounts.zoho.com / mail.zoho.com (por defecto). EU=.eu, IN=.in, etc.
ZOHO_ACCOUNTS_HOST=https://accounts.zoho.com
ZOHO_API_HOST=https://mail.zoho.com
